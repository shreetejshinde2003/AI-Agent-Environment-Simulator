# Copy this file to .env and adjust as needed.

# LOCATION-CHANGING: must match backend/app/core/config.py's HOST:PORT.
VITE_API_BASE_URL=http://localhost:8000

# LOCATION-CHANGING: same host as above, ws:// instead of http://, plus
# the WEBSOCKET_PATH from backend/app/core/config.py.
VITE_WS_URL=ws://localhost:8000/ws/live

# Browser-visible settings must never contain API keys, client secrets or tokens.
# Restart Vite after changes. This development server calls the API directly (no proxy).
# Demo data changes presentation only; it does not grant an authenticated session.
VITE_DEMO_MODE=false
