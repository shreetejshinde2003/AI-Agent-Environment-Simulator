# Copy this file to .env and adjust as needed.

# LOCATION-CHANGING: must match backend/app/core/config.py's HOST:PORT.
VITE_API_BASE_URL=http://localhost:8000

# LOCATION-CHANGING: same host as above, ws:// instead of http://, plus
# the WEBSOCKET_PATH from backend/app/core/config.py.
VITE_WS_URL=ws://localhost:8000/ws/live

# USER-DEFINED: leave this FALSE for real development/demos — the app
# will show genuine zero/empty values until a real backend + real
# agents are connected, which is the correct behavior for a real-time
# dashboard. Only set to true for showing the UI's visual design
# without any backend running (e.g. a design review). Demo mode is
# always visibly labeled in the UI so it's never mistaken for live data.
# Can also be toggled per-session with ?demo=true / ?demo=false in the URL.
VITE_DEMO_MODE=false
