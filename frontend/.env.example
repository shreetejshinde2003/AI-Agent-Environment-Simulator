# Copy this file to .env and adjust as needed.

# Development only: direct local FastAPI origin. Production REST ignores this
# value and uses same-origin /api/v1/* rewrites; never put credentials here.
VITE_API_BASE_URL=http://localhost:8000

# Separate live-event transport. Set the intended WSS endpoint in production.
# Direct Railway WSS cannot use a Vercel host-only session; release gate remains.
VITE_WS_URL=ws://localhost:8000/ws/live
# Keep disabled until the authenticated WebSocket deployment is separately approved.
VITE_LIVE_UPDATES_ENABLED=false

# Browser-visible settings must never contain API keys, client secrets or tokens.
# Restart Vite after changes. This development server calls the API directly (no proxy).
# Demo data changes presentation only; it does not grant an authenticated session.
VITE_DEMO_MODE=false
