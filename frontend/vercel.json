{
  "headers": [
    {
      "source": "/api/v1/auth/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://ai-agent-environment-simulator-production-b4b6.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://ai-agent-environment-simulator-production-b4b6.up.railway.app/health"
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
