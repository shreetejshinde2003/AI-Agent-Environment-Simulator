# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real API keys or credentials.

# --- Database (USER-DEFINED) ---
# Leave as-is for local dev (SQLite, zero setup). Swap for Postgres once
# app/storage/ is activated:
#   DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=sqlite:///./simulator.db

# --- LLM: Ollama (RESERVED / LOCAL FALLBACK) ---
# Requires `ollama serve` running and the model pulled: `ollama pull gemma2:2b`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# --- LLM: Groq (ACTIVE) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Server (LOCATION-CHANGING) ---
# Change PORT if 8000 is already in use on your machine — and remember to
# update the frontend's VITE_API_BASE_URL to match.
HOST=0.0.0.0
PORT=8000

DEBUG=True