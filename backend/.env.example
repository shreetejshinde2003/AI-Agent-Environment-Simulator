# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real API keys or credentials.

# --- Local operational database ---
# Run from backend/ to select backend/simulator.db. Startup initializes fresh SQLite.
# Never copy production database credentials into a collaborator development setup.
DATABASE_URL=sqlite:///./simulator.db
# Optional private benchmark directory; do not publish real employee/HR datasets.
# BENCHMARK_DATA_DIR=/private/benchmarks

# --- Google OAuth development client ---
# Obtain an authorized development Web application client separately; GitHub has no secrets.
# Register the exact redirect below in Google Cloud Console for that client.
# Blank client credentials intentionally cause 503 at login; authentication stays enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Ollama is inactive; no local model service is required.

# --- LLM: Groq (ACTIVE) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Server (LOCATION-CHANGING) ---
# Change PORT if 8000 is already in use on your machine — and remember to
# update the frontend's VITE_API_BASE_URL to match.
HOST=127.0.0.1
PORT=8000

DEBUG=True

# Phase 4.7: leave disabled until restricted-login PostgreSQL acceptance passes.
LANGGRAPH_RUNTIME_ENABLED=false
CHECKPOINT_DATABASE_URL=
CHECKPOINT_SCHEMA=langgraph_checkpoints

# Keep research provider admission and judging disabled for ordinary setup.
RESEARCH_LIVE_ENABLED=false
RESEARCH_JUDGE_ENABLED=false
